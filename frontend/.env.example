# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Client-side Gemini AI key for the customer ordering app.
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_USE_EMULATOR: Set to "true" to connect the client SDK to the Firebase Emulator Suite
VITE_USE_EMULATOR="false"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ── Firebase project configuration ────────────────────────────────────────────
# Copy from the Firebase console: Project Settings → Your apps → SDK setup.
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
