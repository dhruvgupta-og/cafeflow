rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper functions ──────────────────────────────────────────────────────

    function isSignedIn() {
      return request.auth != null;
    }

    function isPlatformAdmin() {
      return isSignedIn() && request.auth.token.role == 'platform_admin';
    }

    // True for cafe_owner or staff whose token.cafeId matches
    function isCafeStaff(cafeId) {
      return isSignedIn() && request.auth.token.cafeId == cafeId &&
             (request.auth.token.role == 'cafe_owner' || request.auth.token.role == 'staff');
    }

    function isCafeOwner(cafeId) {
      return isSignedIn() && request.auth.token.cafeId == cafeId &&
             request.auth.token.role == 'cafe_owner';
    }

    // True if user is staff/owner of that cafe OR a platform admin
    function canAccessCafe(cafeId) {
      return isPlatformAdmin() || isCafeStaff(cafeId);
    }

    // ── /platformAdmins/{uid} ─────────────────────────────────────────────────
    // Only platform admins can read/manage this collection.
    // NEVER publicly readable or writable — first admin must be bootstrapped
    // via the one-time Admin SDK script (backend/scripts/set-admin-claim.ts).
    match /platformAdmins/{uid} {
      allow read:  if isPlatformAdmin();
      allow write: if false; // Admin SDK only (Cloud Functions / one-time script)
    }

    // ── /users/{uid} ──────────────────────────────────────────────────────────
    // A user can read their own doc. Writes are allowed ONLY to safe fields
    // (name, photoUrl etc.). role and cafeId are immutable from the client —
    // only Cloud Functions (Admin SDK) may set them.
    match /users/{uid} {
      allow read: if isSignedIn() && (request.auth.uid == uid || isPlatformAdmin());

      // Users can create their own profile doc but MUST NOT include role/cafeId
      // (those are set by Cloud Functions via Admin SDK).
      allow create: if isSignedIn() && request.auth.uid == uid
                    && !('role'   in request.resource.data)
                    && !('cafeId' in request.resource.data);

      // Users can update display fields only — role and cafeId must not change.
      allow update: if isSignedIn() && request.auth.uid == uid
                    && !('role'   in request.resource.data)
                    && !('cafeId' in request.resource.data);

      allow delete: if isPlatformAdmin();
    }

    // ── /platformStats/{docId} ────────────────────────────────────────────────
    // Written only by Cloud Functions (Admin SDK). Platform admins can read.
    match /platformStats/{docId} {
      allow read:  if isPlatformAdmin();
      allow write: if false;
    }

    // ── /cafes/{cafeId} ───────────────────────────────────────────────────────
    // Public read is needed so the customer ordering app can fetch cafe details
    // and the menu without requiring the customer to be signed in.
    match /cafes/{cafeId} {
      allow read:   if true; // Public — needed for customer menu browsing
      allow create: if isPlatformAdmin();
      allow update: if isPlatformAdmin() || isCafeOwner(cafeId);
      allow delete: if isPlatformAdmin();

      // ── /cafes/{cafeId}/tables ─────────────────────────────────────────────
      match /tables/{tableId} {
        allow read:  if true; // Public — customer needs to verify their table
        allow write: if canAccessCafe(cafeId);
      }

      // ── /cafes/{cafeId}/menuCategories ────────────────────────────────────
      match /menuCategories/{catId} {
        allow read:  if true; // Public — customer menu browsing
        allow write: if canAccessCafe(cafeId);

        // ── /cafes/{cafeId}/menuCategories/{catId}/items ───────────────────
        match /items/{itemId} {
          // Public read — but only available items visible to customers.
          // Staff can read all items (including unavailable) to manage the menu.
          allow read: if resource.data.isAvailable == true || canAccessCafe(cafeId);
          allow write: if canAccessCafe(cafeId);
        }
      }

      // ── /cafes/{cafeId}/orders ─────────────────────────────────────────────
      match /orders/{orderId} {
        // Staff can read and update any order for their cafe.
        allow read:   if canAccessCafe(cafeId);
        allow update: if canAccessCafe(cafeId);
        allow delete: if isPlatformAdmin();

        // Customers (unauthenticated) can CREATE an order with validated fields:
        //  - status must start as "New"
        //  - items must be a non-empty list
        //  - tableId must be a non-empty string
        // Price validation against the live menu must be done server-side in the
        // Cloud Function that processes the order (client prices are untrusted).
        allow create: if request.resource.data.status == 'New'
                      && request.resource.data.items is list
                      && request.resource.data.items.size() > 0
                      && request.resource.data.tableId is string
                      && request.resource.data.tableId.size() > 0;
      }

      // ── /cafes/{cafeId}/bills ──────────────────────────────────────────────
      // Billing is internal — never exposed to customers.
      match /bills/{billId} {
        allow read, write: if canAccessCafe(cafeId);
      }

      // ── /cafes/{cafeId}/alerts ─────────────────────────────────────────────
      // Customers can CREATE alerts (call waiter, bill request).
      // Only staff can read and resolve them.
      match /alerts/{alertId} {
        allow read, update, delete: if canAccessCafe(cafeId);
        allow create: if true; // Unauthenticated customers can raise alerts
      }

      // ── /cafes/{cafeId}/staff ──────────────────────────────────────────────
      // Staff can read their own record; owner/admin can manage all staff docs.
      match /staff/{staffUid} {
        allow read:  if canAccessCafe(cafeId) ||
                        (isSignedIn() && request.auth.uid == staffUid);
        allow write: if isPlatformAdmin() || isCafeOwner(cafeId);
      }

      // ── /cafes/{cafeId}/invitations ───────────────────────────────────────
      // Readable by anyone who knows the exact token (needed for invite flow).
      // Writable only by platform admins (invitation creation via Cloud Function).
      // The acceptInvitation CF marks them accepted server-side.
      match /invitations/{token} {
        allow get:   if true;    // Single-doc GET by exact token is allowed
        allow list:  if isPlatformAdmin(); // Listing requires admin
        allow write: if false;   // Cloud Function (Admin SDK) only
      }
    }

    // ── /invitations/{token} (root collection mirror) ─────────────────────────
    match /invitations/{token} {
      allow get:   if true;    // Single-doc GET by exact token is allowed
      allow list:  if isPlatformAdmin();
      allow write: if false;   // Cloud Function (Admin SDK) only
    }

    // ── Catch-all: deny everything not explicitly matched above ───────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
