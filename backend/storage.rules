rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // ── /cafes/{cafeId}/... ───────────────────────────────────────────────────
    // Public read for all cafe assets (menu photos, logos) so the customer
    // ordering app can display them without authentication.
    // Write restricted to that cafe's staff/owner or a platform admin.
    // Enforced limits: 5 MB max, image/* content type only.
    match /cafes/{cafeId}/{allPaths=**} {
      allow read: if true;

      allow write: if request.auth != null
        && (
          request.auth.token.role == 'platform_admin'
          || (request.auth.token.cafeId == cafeId
              && (request.auth.token.role == 'cafe_owner'
                  || request.auth.token.role == 'staff'))
        )
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // ── Catch-all: deny everything else ──────────────────────────────────────
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
